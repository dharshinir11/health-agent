# Healthcare AI Appointment Assistant - Environment Variables
# Copy this file to .env and fill in your values

# LLM Configuration (Google Gemini - used in n8n workflow)
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face Embeddings (for RAG - free API key from huggingface.co)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# n8n Configuration
N8N_WEBHOOK_URL=https://mmsampathram.app.n8n.cloud/webhook/healthcare-appointment


# Qdrant Vector Database (used for RAG retrieval)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///database/healthcare.db

# Application Configuration
APP_ENV=development
DEBUG=True
APP_PORT=8501

# Security
SECRET_KEY=your_secret_key_here_change_in_production
